<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MLInstallerSharp</AssemblyName>
    <RootNamespace>MLInstallerSharp</RootNamespace>
    <PackageId>MLInstallerSharp</PackageId>
    <Title>MLInstallerSharp</Title>
    <Description>A lightweight C# library for fetching and downloading MelonLoader stable releases and CI builds.</Description>
	<Version>1.0.0</Version>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<Authors>Gameknight963</Authors>
	<RepositoryUrl>https://github.com/Gameknight963/MLInstallerSharp</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageProjectUrl>https://github.com/Gameknight963/MLInstallerSharp</PackageProjectUrl>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageLicenseFile>LICENSE</PackageLicenseFile>
	<PackageTags>MelonLoader;Unity;Modding;Install</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Semver" Version="3.0.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" />
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Update="LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
